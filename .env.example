# ─────────────────────────────────────────────────────────────
# Root environment for docker-compose
# Copy to `.env` and adjust as needed
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=uni
POSTGRES_PASSWORD=uni_secret
POSTGRES_DB=uni_tcms
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=4000
NODE_ENV=development
#DATABASE_URL=postgresql://uni:uni_secret@postgres:5432/uni_tcms?schema=public
DATABASE_URL=postgresql://postgres:waiwiki_pass@localhost:5432/task?schema=eimple
JWT_ACCESS_SECRET=change-me-access-secret-in-production
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:5373

# Refresh-cookie flags. Only set COOKIE_SECURE=true when the site is served over
# https: a Secure cookie is discarded by the browser on an http origin, so the
# session survives in memory but dies on the first page refresh.
# COOKIE_SAMESITE=none (needed when frontend and API are on different sites)
# requires COOKIE_SECURE=true, and is downgraded to lax otherwise.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Redis (Socket.IO adapter / caching — optional but wired)
REDIS_URL=redis://redis:6379

# Frontend
FRONTEND_PORT=5373
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000
